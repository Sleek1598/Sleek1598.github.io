---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Phillip Pieterse | Operations + Tech',
  description = 'Specialized Operations Manager building practical digital systems, dashboards, and modern web experiences.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
  </head>
  <body>
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
