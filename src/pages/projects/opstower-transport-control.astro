---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<MainLayout
  title="OpsTower Transport Control | Phillip Pieterse"
  description="OpsTower Transport Control is a transport visibility and delay-intelligence module focused on truck movement, checkpoints, and follow-up."
>
  <SiteHeader />

  <main class="page-shell">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Module</div>
        <h1 class="page-title">OpsTower Transport Control</h1>
        <p class="page-copy">
          A transport visibility and delay-intelligence module designed to improve checkpoint
          tracking, truck movement monitoring, and intervention speed.
        </p>
      </div>

      <section class="surface">
        <div class="badge-row">
          <span class="badge live">In progress</span>
          <span class="tag">Transport control</span>
          <span class="tag">Delay intelligence</span>
          <span class="tag">Linehaul visibility</span>
        </div>

        <h2 class="section-title">Built to improve movement visibility and follow-up.</h2>
        <p class="section-copy">
          This module is being developed as part of OpsTower to support linehaul and transport
          operations with clearer movement visibility, expected checkpoint tracking, docking
          intelligence, and better delay follow-up.
        </p>

        <div class="detail-grid">
          <article class="detail-card metric-card">
            <div class="detail-label">Focus</div>
            <div class="detail-value">Truck visibility</div>
          </article>
          <article class="detail-card metric-card">
            <div class="detail-label">Purpose</div>
            <div class="detail-value">Checkpoint intelligence</div>
          </article>
          <article class="detail-card metric-card">
            <div class="detail-label">Direction</div>
            <div class="detail-value">Delay follow-up</div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="eyebrow">Planned capabilities</div>
          <h2 class="section-title">What this module is aiming to deliver</h2>
        </div>

        <div class="highlight-grid">
          <article class="highlight-card">
            <h3>Truck visibility</h3>
            <p class="detail-copy">
              A clearer view of where transport assets are, how they are moving, and where attention is needed.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Checkpoint intelligence</h3>
            <p class="detail-copy">
              Monitoring expected progress points to improve awareness of delays, misses, and off-plan movement.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Delay follow-up</h3>
            <p class="detail-copy">
              Better visibility into transport issues so intervention can happen earlier and more consistently.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Operational control surfaces</h3>
            <p class="detail-copy">
              A stronger system for supporting linehaul and transport operations with clearer monitoring and response tools.
            </p>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="surface">
          <div class="section-head">
            <div class="eyebrow">Back to platform</div>
            <h2 class="section-title">Part of the broader OpsTower system.</h2>
            <p class="section-copy">
              Transport Control extends OpsTower from visibility into stronger movement
              monitoring, transport follow-up, and delay intelligence.
            </p>
          </div>

          <div class="hero-actions">
            <a class="primary-button" href="/projects/opstower">Back to OpsTower</a>
            <a class="ghost-button" href="/projects/opstower-route-optimization">
              View Route Optimization
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</MainLayout>