---
import MainLayout from '../layouts/MainLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<MainLayout
  title="Phillip Pieterse | OpsTower, Operations + Tech"
  description="Portfolio of Phillip Pieterse, a Specialized Operations Manager building OpsTower and practical digital systems for operations, visibility, and control."
>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-card">
          <div class="kicker">Operations + Tech</div>
          <h1>Building clarity for real operational systems.</h1>
          <p class="hero-copy">
            I’m Phillip Pieterse, a Specialized Operations Manager building practical digital
            systems that make complex work clearer and easier to manage. My focus sits at the
            intersection of operations, dashboards, route optimization, transport visibility,
            and modern web experiences.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href="/projects/opstower">View OpsTower</a>
            <a class="ghost-button" href="/projects">Browse projects</a>
          </div>

          <div class="hero-stats">
            <div class="stat-card">
              <div class="stat-label">Focus</div>
              <div class="stat-value">Dashboards</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Strength</div>
              <div class="stat-value">Operational clarity</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Stack</div>
              <div class="stat-value">Next.js + TypeScript</div>
            </div>
          </div>

          <div class="proof-strip">
            <div class="proof-item">Live KPI monitoring</div>
            <div class="proof-item">Route optimization</div>
            <div class="proof-item">Transport control</div>
            <div class="proof-item">Admin surfaces</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <div class="eyebrow">Featured platform</div>
          <h2 class="section-title">OpsTower</h2>
          <p class="section-copy">
            OpsTower is an operational intelligence platform focused on live visibility,
            reporting truth, route planning, and transport control.
          </p>
        </div>

        <article class="project-card featured">
          <div class="badge-row">
            <span class="badge live">Platform</span>
            <span class="tag">Operational intelligence</span>
            <span class="tag">Route optimization</span>
            <span class="tag">Transport control</span>
          </div>

          <h3>OpsTower</h3>
          <p class="project-copy">
            OpsTower is a growing operational platform designed to improve visibility, control,
            and decision-making across live operations. It combines dashboarding, intervention
            workflows, route optimization, and transport monitoring into one structured system.
          </p>

          <div class="project-meta">
            <span class="tag">Live visibility</span>
            <span class="tag">Reporting truth</span>
            <span class="tag">Admin control</span>
            <span class="tag">Decision support</span>
          </div>

          <div class="project-preview contain-frame">
            <img
              src="/images/projects/opstower/live-overview.png"
              alt="OpsTower live overview screenshot"
            />
          </div>

          <div class="hero-actions">
            <a class="primary-button" href="/projects/opstower">Explore OpsTower</a>
            <a class="ghost-button" href="/projects">View projects</a>
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <div class="eyebrow">What I like building</div>
          <h2 class="section-title">Useful systems with operational depth.</h2>
        </div>

        <div class="highlight-grid">
          <article class="highlight-card">
            <h3>Operational dashboards</h3>
            <p class="detail-copy">
              Interfaces that help teams see the state of work quickly, spot risk early, and
              act with confidence.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Route optimization tools</h3>
            <p class="detail-copy">
              Planning systems that support route QA, stop sequencing, and better operational
              decision-making.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Transport visibility</h3>
            <p class="detail-copy">
              Systems that bring clearer movement visibility, checkpoint awareness, and stronger
              follow-up into transport operations.
            </p>
          </article>

          <article class="highlight-card">
            <h3>Admin and control surfaces</h3>
            <p class="detail-copy">
              Tools that reduce noise, improve consistency, and support teams with better
              visibility and control.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>